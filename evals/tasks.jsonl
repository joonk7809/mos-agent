{"id": "settings-dark-mode", "task": "Turn on dark theme in Settings.", "check": "settings get secure ui_night_mode", "expect": "2"}
{"id": "settings-wifi-off", "task": "Turn Wi-Fi off.", "check": "settings get global wifi_on", "expect": "0"}
{"id": "settings-airplane-on", "task": "Turn on airplane mode.", "check": "settings get global airplane_mode_on", "expect": "1"}
{"id": "settings-screen-timeout", "task": "Set the screen timeout to 10 minutes.", "check": "settings get system screen_off_timeout", "expect": "600000"}
{"id": "settings-dnd-on", "task": "Turn on Do Not Disturb.", "check": "settings get global zen_mode", "expect_nonzero": true}
{"id": "clock-alarm", "task": "Set an alarm for 7:30 AM in the Clock app.", "check": "dumpsys alarm | grep -c com.google.android.deskclock", "expect_changed": true, "note": "weak: checks that the Clock app scheduled something new, not the time"}
{"id": "contacts-add", "task": "Add a contact named Ada Lovelace with phone number 555-0100.", "checks": [{"check": "content query --uri content://com.android.contacts/data --projection data1 --where \"data1='Ada Lovelace'\"", "expect_contains": "Ada Lovelace"}, {"check": "content query --uri content://com.android.contacts/data --projection data1 --where \"mimetype='vnd.android.cursor.item/phone_v2'\"", "expect_contains": "0100"}]}
{"id": "calendar-event", "task": "Create a calendar event tomorrow at 3 PM titled Dentist.", "check": "content query --uri content://com.android.calendar/events --projection title", "expect_contains": "Dentist", "note": "checks the title only, not the time"}
{"id": "chrome-search", "task": "Open Chrome and search for the weather in Seoul.", "check": "dumpsys window | grep mCurrentFocus", "expect_contains": "chrome", "note": "weak: only checks Chrome is in front"}
